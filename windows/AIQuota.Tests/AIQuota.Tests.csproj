<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable><IsPublishable>false</IsPublishable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"><PrivateAssets>all</PrivateAssets></PackageReference>
    <ProjectReference Include="../AIQuota.Core/AIQuota.Core.csproj" />
    <ProjectReference Include="../AIQuota.FakeServer/AIQuota.FakeServer.csproj" ReferenceOutputAssembly="false" />
    <None Include="../../Tests/QuotaCoreTests/Fixtures/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyFakeServer" AfterTargets="Build">
    <ItemGroup><FakeFiles Include="../AIQuota.FakeServer/bin/$(Configuration)/$(TargetFramework)/AIQuota.FakeServer.*" /></ItemGroup>
    <Copy SourceFiles="@(FakeFiles)" DestinationFolder="$(OutDir)fake" />
  </Target>
</Project>
